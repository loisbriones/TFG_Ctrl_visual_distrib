<?xml version="1.0"?>
<package format="3">
  <name>image_processor_pkg</name>
  <version>0.0.0</version>
  <description>Image processing and communication between Raspberries</description>
  <maintainer email="user@todo.com">User</maintainer>
  <license>Apache-2.0</license>

  <!-- ament_cmake y no ament_python aunque los nodos sean de Python, porque los
       mensajes de msg/ solo se pueden generar desde CMake. Los .py se instalan
       como PROGRAMS en el CMakeLists -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclpy</depend>
  <depend>builtin_interfaces</depend>
  <!-- get_package_share_directory: lo usa VisualizacionNode.py para localizar
       los ficheros de la pagina del panel (web/, instalada en el share) -->
  <exec_depend>ament_index_python</exec_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
